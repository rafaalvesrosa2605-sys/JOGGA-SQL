erDiagram
    USUARIO ||--o{ RESERVA : "faz"
    QUADRA ||--o{ RESERVA : "recebe"
    MODALIDADE ||--o{ RESERVA : "praticada em"
    QUADRA ||--o{ QUADRA_MODALIDADE : "oferece"
    MODALIDADE ||--o{ QUADRA_MODALIDADE : "existe em"
    RESERVA ||--o{ PAGAMENTO : "paga por"
    RESERVA ||--o| AVALIACAO : "recebe"

    USUARIO {
        int id_usuario PK
        varchar nome
        char cpf UK
        varchar email UK
        varchar telefone
        varchar senha_hash
        enum perfil "CLIENTE, RECEPCAO, ADMIN"
        datetime criado_em
    }
    MODALIDADE {
        int id_modalidade PK
        varchar nome UK
    }
    QUADRA {
        int id_quadra PK
        varchar nome UK
        varchar tipo_piso
        boolean coberta
        decimal valor_hora
        boolean ativa
    }
    QUADRA_MODALIDADE {
        int id_quadra PK, FK
        int id_modalidade PK, FK
    }
    RESERVA {
        int id_reserva PK
        int id_usuario FK
        int id_quadra FK
        int id_modalidade FK
        date data_reserva
        time hora_inicio
        enum status
        decimal valor
        datetime criado_em
        time hora_ocupada "calculada"
    }
    PAGAMENTO {
        int id_pagamento PK
        int id_reserva FK
        enum forma "PIX, CARTAO, DINHEIRO"
        decimal valor
        datetime pago_em
    }
    AVALIACAO {
        int id_avaliacao PK
        int id_reserva FK, UK
        int nota "1 a 5"
        varchar comentario
    }
